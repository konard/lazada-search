  "classification": {
    "kind": "pseudonymous-telemetry-identifiers-and-page-behavior-metadata",
    "basis": "Observed mmstat host requests return a shared43-byte GIF and have telemetry/event/page/device fields. Records contain no observed Cookie/Authorization/password/token keys. Classification is inference from committed traffic shape, not vendor documentation.",
    "notDemonstrated": "No password, OTP, bearer access/refresh token, login cookie header or authenticated-session secret was identified in these targeted telemetry rows.",
    "qualification": "cna/ckx/asid are still identifier-bearing fields; absence of explicit credential keys is not proof that arbitrary tracking parameters can never be security-relevant."

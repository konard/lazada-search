{
  "name": "lazada-search",
  "version": "0.11.31",
  "description": "Cached, evidence-backed Lazada protein and ice-cream comparison library, CLI and Telegram bot",
  "type": "module",
  "main": "src/index.js",
  "types": "src/index.d.ts",
  "bin": {
    "lazada-search": "./bin/lazada-search.js"
  },
  "files": [
    "bin/",
    "src/",
    "CHANGELOG.md",
    "LICENSE",
    "README.md"
  ],
  "exports": {
    ".": {
      "types": "./src/index.d.ts",
      "import": "./src/index.js"
    }
  },
  "scripts": {
    "test": "node --test --test-concurrency=4 --test-timeout=300000 tests/*.test.js",
    "lint": "node scripts/lint.mjs",
    "lint:all": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check:duplication": "jscpd .",
    "check": "npm run lint && npm run format:check && npm run check:duplication",
    "example:web:dev": "npm --prefix examples/universal-app run dev",
    "example:web:build": "npm --prefix examples/universal-app run build",
    "example:web:preview": "npm --prefix examples/universal-app run preview",
    "example:web:preview-images": "node scripts/update-preview-images.mjs",
    "example:desktop:package": "npm --prefix examples/universal-app run desktop:package",
    "example:desktop:make": "npm --prefix examples/universal-app run desktop:make",
    "example:mobile:sync": "npm --prefix examples/universal-app run mobile:sync",
    "prepare": "node scripts/install-git-hooks.mjs",
    "changeset": "changeset",
    "changeset:version": "node scripts/changeset-version.mjs",
    "changeset:publish": "changeset publish",
    "changeset:status": "changeset status --since=origin/main",
    "test:e2e": "node --test --test-concurrency=1 --test-timeout=120000 tests/e2e/*.test.js",
    "test:live": "node scripts/live-acceptance.mjs"
  },
  "keywords": [
    "lazada",
    "protein",
    "ice-cream",
    "browser-commander",
    "links-notation",
    "ocr",
    "telegram"
  ],
  "author": "",
  "license": "Unlicense",
  "devEngines": {
    "packageManager": {
      "name": "npm"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/konard/lazada-search.git"
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.3",
    "eslint": "^9.38.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.4",
    "husky": "^9.1.7",
    "jscpd": "^5.4.0",
    "lint-staged": "^16.4.0",
    "prettier": "^3.6.2",
    "test-anywhere": "^0.8.48"
  },
  "lint-staged": {
    "*.{js,mjs,cjs}": [
      "eslint --fix --max-warnings 0 --no-warn-ignored",
      "prettier --write",
      "prettier --check"
    ],
    "*.md": [
      "prettier --write",
      "prettier --check"
    ]
  },
  "dependencies": {
    "browser-commander": "^0.27.0",
    "grammy": "^1.46.0",
    "linkedom": "^0.18.13",
    "links-notation": "^0.25.1",
    "lino-arguments": "0.3.0",
    "lino-objects-codec": "^0.9.0",
    "playwright": "^1.64.0",
    "yaml": "^2.9.0"
  }
}

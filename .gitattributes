# Cached Links Notation strings preserve the original page text, including spaces.
tests/fixtures/public-cache/**/*.lino whitespace=-blank-at-eol

# Source receipts hash the downloaded bytes. Git must not convert their line endings.
docs/acceptance/** -text
tests/fixtures/** -text
data/cases/** -text

# CLI shebangs must stay portable when a release is checked out on Windows.
bin/** text eol=lf
